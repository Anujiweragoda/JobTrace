DATABASE_URL="postgresql://username:password@localhost:5432/jobtrace?schema=public"
# Google OAuth credentials (set these in your host/CI environment, not in the repo)
GOOGLE_CLIENT_ID=REPLACE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_ME_GOOGLE_CLIENT_SECRET
# JWT signing secret. Use a long, random string.
JWT_SECRET=REPLACE_ME_JWT_SECRET
