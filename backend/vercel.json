{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/ping", "dest": "/api/ping.ts" },
    { "src": "/api/health", "dest": "/api/ping.ts" },
    { "src": "/api/debug", "dest": "/api/debug.ts" },
    { "src": "/api/auth/login", "dest": "/api/auth/login.ts" },
    { "src": "/api/auth/signup", "dest": "/api/auth/signup.ts" },
    { "src": "/api/auth/me", "dest": "/api/auth/me.ts" },
    { "src": "/api/auth/google", "dest": "/api/auth/google.ts" },
    { "src": "/api/applications/preview", "dest": "/api/applications/preview.ts" },
    
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
