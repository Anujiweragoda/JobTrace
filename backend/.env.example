# Copy this file to `.env` and set your Postgres connection string.
# Example (local Postgres):
# DATABASE_URL="postgresql://user:password@localhost:5432/job_tracker?schema=public"

DATABASE_URL="postgresql://user:password@localhost:5432/job_tracker?schema=public"

# Authentication and OAuth
# JWT secret used to sign session tokens. Set a long random string in production.
JWT_SECRET=replace-me-with-a-strong-secret
# Google OAuth client ID for verifying Google ID tokens
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
